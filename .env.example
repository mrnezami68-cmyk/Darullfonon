# Frontend — public Clerk publishable key only (never put a secret here)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional Clerk Session Token template containing email, email_verified and name claims
VITE_CLERK_JWT_TEMPLATE=darullfonon

# Worker secrets/vars are set with Wrangler, not committed to this file:
# npx wrangler secret put CLERK_JWT_KEY --config wrangler.toml
# npx wrangler secret put CLERK_JWT_ISSUER --config wrangler.toml
# npx wrangler secret put CLERK_JWT_AUDIENCE --config wrangler.toml # optional, required when template sets aud
# Required: exact Pages origin(s), comma-separated; must match the token azp claim.
# npx wrangler secret put CLERK_AUTHORIZED_PARTIES --config wrangler.toml
# npx wrangler secret put BOOTSTRAP_ADMIN_PROVIDER_SUBJECT --config wrangler.toml
#
# Non-secret Worker var:
# ALLOWED_ORIGIN=https://app.example.com
